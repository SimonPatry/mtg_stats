# Copie ce fichier en .env et complète les valeurs vides.

# ─── Base de données ──────────────────────────────────────────────────────
# En local hors Docker (npm start) : 127.0.0.1
# Avec `docker compose up`, l'app force DB_HOST=db — cette valeur sert surtout
# à npm start / import:test depuis l'hôte.
DB_HOST=127.0.0.1
# Change-le si 3306 est déjà pris : DB_PORT=3307 docker compose up -d
DB_PORT=3306
DB_USER=mtg
DB_PASSWORD=mtg
DB_NAME=mtg
# Base des tests d'intégration — vidée à chaque exécution.
DB_TEST_NAME=mtg_test

# ─── Application ──────────────────────────────────────────────────────────
PORT=3000
# Secret de signature des jetons. Générer avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Compte admin initial (créé au démarrage seulement si la table accounts est vide).
ADMIN_USERNAME=admin
# Hash du mot de passe admin initial. Générer avec :
#   npm run hash-password -- "mon mot de passe"
ADMIN_PASSWORD_HASH=
# Utile seulement si le front est servi depuis une autre origine que l'API.
CORS_ORIGIN=http://localhost:5173
# 1 derrière un reverse proxy HTTPS (Plesk prod), pour poser des cookies Secure.
SECURE_COOKIES=0
# Tentatives de connexion / inscription autorisées par quart d'heure (10 par défaut).
LOGIN_RATE_LIMIT=10

# ─── Plesk (rappel) ───────────────────────────────────────────────────────
# Root d'application : /httpdocs
# Racine du document : /httpdocs/dist
# Fichier de démarrage : app.js
# .env à la racine httpdocs/ (JWT_SECRET, ADMIN_*, DB_*, SECURE_COOKIES=1)
