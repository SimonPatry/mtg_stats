# Copie ce fichier en .env et complète les deux valeurs vides.

# ─── Base de données (docker compose up -d) ───────────────────────────────
DB_HOST=127.0.0.1
# Change-le si 3306 est déjà pris : DB_PORT=3307 docker compose up -d
DB_PORT=3306
DB_USER=mtg
DB_PASSWORD=mtg
DB_NAME=mtg
# Base des tests d'intégration — vidée à chaque exécution.
DB_TEST_NAME=mtg_test

# ─── Application ──────────────────────────────────────────────────────────
PORT=3000
# Secret de signature des jetons. Générer avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Hash du mot de passe d'administration. Générer avec :
#   npm run hash-password -- "mon mot de passe"
ADMIN_PASSWORD_HASH=
# Utile seulement si le front est servi depuis une autre origine que l'API.
CORS_ORIGIN=http://localhost:5173
# 1 derrière un reverse proxy HTTPS, pour poser des cookies Secure.
SECURE_COOKIES=0
# Tentatives de connexion autorisées par quart d'heure (10 par défaut). À monter
# seulement en local, quand les suites navigateur enchaînent les connexions.
LOGIN_RATE_LIMIT=10
