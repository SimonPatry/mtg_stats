    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "mysql2": "^3.24.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "uuid": "^14.0.2",
    "xlsx": "^0.18.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.5.2",
    "playwright": "^1.63.0",
    "vite": "^6.3.5"
